# Curlew configuration — copy to .env and adjust. Everything here is optional:
# credentials come from GNOME Online Accounts at runtime and are NEVER stored here.

# Where the local index lives. Defaults to $XDG_DATA_HOME/curlew (~/.local/share/curlew).
# NEVER point this inside the repository — the index contains message bodies.
# POSTBOTE_DATA_DIR=/home/you/.local/share/curlew

# The index file itself. Must end in `.db`: gjsify's node:sqlite runs on libgda, which always
# appends `.db` to the database name — `index.sqlite` would land on disk as `index.sqlite.db`.
# POSTBOTE_DB_PATH=/home/you/.local/share/curlew/index.db

# Where `curlew save` writes attachments. Defaults to $XDG_DOWNLOAD_DIR, else ~/Downloads.
# POSTBOTE_ATTACHMENTS_DIR=/home/you/Downloads

# Allow the MCP server to register write tools. There are none in v1; the gate exists so that
# adding one is a deliberate act rather than a side effect.
# POSTBOTE_MCP_ALLOW_WRITE=1
