{
  "name": "curlew-cli",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Curlew app: the `curlew` binary \u2014 CLI + MCP frontends over the @curlew/* packages, bundled to a single .gjs.mjs and run on GJS via gjsify.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "gjsify tsc --noEmit",
    "format": "gjsify format --write .",
    "format:check": "gjsify format --check .",
    "lint": "gjsify lint .",
    "lint:fix": "gjsify lint --fix .",
    "build": "gjsify run build:gjs",
    "build:gjs": "gjsify build src/index.ts --app gjs --external jimp,sharp --outfile dist/curlew.gjs.mjs",
    "build:node": "gjsify build src/index.ts --app node --external jimp,sharp --outfile dist/curlew.node.mjs",
    "start": "gjsify run dist/curlew.gjs.mjs",
    "dev": "gjsify run build:gjs && gjsify run start",
    "test": "DBUS_SESSION_BUS_ADDRESS=unix:path=/nonexistent XDG_RUNTIME_DIR=/nonexistent gjsify test",
    "test:mcp": "node tests/integration/mcp-gjs-smoke.mjs",
    "test:relocation": "node tests/integration/bundle-relocation.mjs",
    "test:telegram-network": "gjsify build tests/integration/telegram-handshake.ts --app gjs --outfile dist/telegram-handshake.gjs.mjs && gjsify run dist/telegram-handshake.gjs.mjs",
    "test:signal-network": "gjsify build tests/integration/signal-provisioning.ts --app gjs --outfile dist/signal-provisioning.gjs.mjs && gjsify run dist/signal-provisioning.gjs.mjs",
    "test:whatsapp-network": "gjsify build tests/integration/whatsapp-qr.ts --app gjs --external jimp,sharp --outfile dist/whatsapp-qr.gjs.mjs && gjsify run dist/whatsapp-qr.gjs.mjs",
    "test:xmpp-server": "node tests/integration/xmpp-archive.mjs",
    "test:matrix-e2ee": "gjsify build tests/integration/matrix-e2ee-gjs.ts --app gjs --outfile dist/matrix-e2ee.gjs.mjs && node tests/integration/matrix-e2ee.mjs"
  },
  "gjsify": {
    "ship": {
      "appId": "eu.jumplink.curlew",
      "binaryName": "curlew",
      "kind": "cli",
      "name": "Curlew",
      "bundle": {
        "linux": "dist/curlew.gjs.mjs",
        "darwin": "dist/curlew.node.mjs",
        "win32": "dist/curlew.node.mjs"
      },
      "app": {
        "darwin": "node",
        "win32": "node"
      },
      "developer": {
        "id": "eu.jumplink",
        "name": "Pascal Garber",
        "email": "pascal@jumplink.eu"
      },
      "summary": "Mail, contacts and calendar on the command line and as an MCP server",
      "license": {
        "project": "AGPL-3.0-or-later"
      },
      "description": "curlew reads the mail (IMAP), contacts (CardDAV) and calendar (CalDAV) of the accounts already configured in GNOME Online Accounts, as a CLI and an MCP server. Read-only: it never sets \\Seen, sends mail, or writes to a server. GNOME Online Accounts and Evolution Data Server are Linux-only, so the macOS and Windows packages ship with every account backend unavailable \u2014 see the Releasing section of README.md.",
      "homepageUrl": "https://github.com/JumpLink/postbote",
      "bugtrackerUrl": "https://github.com/JumpLink/postbote/issues",
      "vcsBrowserUrl": "https://github.com/JumpLink/postbote",
      "typelibPackages": {
        "EBook-1.2": { "deb": "gir1.2-ebook-1.2", "rpm": "evolution-data-server-libs" },
        "EBookContacts-1.2": { "deb": "gir1.2-ebookcontacts-1.2", "rpm": "evolution-data-server-libs" },
        "ECal-2.0": { "deb": "gir1.2-ecal-2.0", "rpm": "evolution-data-server-libs" },
        "EDataServer-1.2": { "deb": "gir1.2-edataserver-1.2", "rpm": "evolution-data-server-libs" },
        "Goa-1.0": { "deb": "gir1.2-goa-1.0", "rpm": "gnome-online-accounts-libs" },
        "ICalGLib-3.0": { "deb": "gir1.2-ical-3.0", "rpm": "libical-glib" }
      }
    },
    "excludeGlobals": [
      "document",
      "HTMLElement",
      "location",
      "Image",
      "HTMLCanvasElement",
      "HTMLImageElement",
      "FontFace",
      "matchMedia",
      "MutationObserver",
      "ResizeObserver",
      "IntersectionObserver",
      "AudioContext",
      "RTCPeerConnection",
      "MediaStream",
      "RTCSessionDescription",
      "RTCIceCandidate",
      "MediaStreamTrack"
    ],
    "test": {
      "entry": "tests/test.mts",
      "outdir": "dist",
      "runtimes": [
        "gjs",
        "node"
      ]
    }
  },
  "optionalDependencies": {
    "@gjsify/node-runtime-darwin-arm64": "0.55.0",
    "@gjsify/node-runtime-darwin-x64": "0.55.0",
    "@gjsify/node-runtime-win32-x64": "0.55.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@curlew/gnome": "*",
    "@curlew/imap": "*",
    "@curlew/matrix": "*",
    "@curlew/protocol": "*",
    "@curlew/smtp": "*",
    "@curlew/signal": "*",
    "@curlew/store": "*",
    "@curlew/telegram": "*",
    "@curlew/whatsapp": "*",
    "@curlew/xmpp": "*",
    "dotenv": "^17.4.2",
    "yargs": "^18.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@gjsify/cli": "0.55.0",
    "@gjsify/mcp": "0.55.0",
    "@gjsify/napi": "0.55.0",
    "@gjsify/node-globals": "0.55.0",
    "@gjsify/rolldown-native": "0.55.0",
    "@gjsify/runtime": "0.55.0",
    "@gjsify/unit": "0.55.0",
    "@gjsify/ws": "0.55.0",
    "@girs/gjs": "^4.1.0",
    "@girs/glib-2.0": "^4.1.0",
    "@girs/gobject-2.0": "^4.1.0",
    "@girs/gio-2.0": "^4.1.0",
    "@girs/goa-1.0": "^4.1.0",
    "@girs/edataserver-1.2": "^4.1.0",
    "@girs/ebook-1.2": "^4.1.0",
    "@girs/ebookcontacts-1.2": "^4.1.0",
    "@girs/ecal-2.0": "^4.1.0",
    "@girs/icalglib-3.0": "^4.1.0",
    "@signalapp/libsignal-client": "0.103.0",
    "@types/node": "^26.1.2",
    "@types/yargs": "^17.0.35",
    "baileys": "7.0.0-rc14",
    "@xmpp/client": "0.14.0",
    "fake-indexeddb": "6.2.5",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^6.0.3"
  }
}
