{
  "name": "postbote-cli",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Postbote app: the `postbote` binary \u2014 CLI + MCP frontends over the @postbote/* packages, bundled to a single .gjs.mjs and run on GJS via gjsify.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "gjsify tsc --noEmit",
    "format": "gjsify format --write .",
    "format:check": "gjsify format --check .",
    "lint": "gjsify lint .",
    "lint:fix": "gjsify lint --fix .",
    "build": "gjsify run build:gjs",
    "build:gjs": "gjsify build src/index.ts --app gjs --external jimp,sharp --outfile dist/postbote.gjs.mjs",
    "start": "gjsify run dist/postbote.gjs.mjs",
    "dev": "gjsify run build:gjs && gjsify run start",
    "test": "DBUS_SESSION_BUS_ADDRESS=unix:path=/nonexistent XDG_RUNTIME_DIR=/nonexistent gjsify test",
    "test:mcp": "node tests/integration/mcp-gjs-smoke.mjs",
    "test:relocation": "node tests/integration/bundle-relocation.mjs",
    "test:telegram-network": "gjsify build tests/integration/telegram-handshake.ts --app gjs --outfile dist/telegram-handshake.gjs.mjs && gjsify run dist/telegram-handshake.gjs.mjs",
    "test:signal-network": "gjsify build tests/integration/signal-provisioning.ts --app gjs --outfile dist/signal-provisioning.gjs.mjs && gjsify run dist/signal-provisioning.gjs.mjs",
    "test:whatsapp-network": "gjsify build tests/integration/whatsapp-qr.ts --app gjs --external jimp,sharp --outfile dist/whatsapp-qr.gjs.mjs && gjsify run dist/whatsapp-qr.gjs.mjs",
    "test:xmpp-server": "node tests/integration/xmpp-archive.mjs",
    "test:matrix-e2ee": "gjsify build tests/integration/matrix-e2ee-gjs.ts --app gjs --outfile dist/matrix-e2ee.gjs.mjs && node tests/integration/matrix-e2ee.mjs"
  },
  "gjsify": {
    "excludeGlobals": [
      "document",
      "HTMLElement",
      "location",
      "Image",
      "HTMLCanvasElement",
      "HTMLImageElement",
      "FontFace",
      "matchMedia",
      "MutationObserver",
      "ResizeObserver",
      "IntersectionObserver",
      "AudioContext",
      "RTCPeerConnection",
      "MediaStream",
      "RTCSessionDescription",
      "RTCIceCandidate",
      "MediaStreamTrack"
    ],
    "test": {
      "entry": "tests/test.mts",
      "outdir": "dist",
      "runtimes": [
        "gjs",
        "node"
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@postbote/gnome": "*",
    "@postbote/imap": "*",
    "@postbote/matrix": "*",
    "@postbote/protocol": "*",
    "@postbote/signal": "*",
    "@postbote/store": "*",
    "@postbote/telegram": "*",
    "@postbote/whatsapp": "*",
    "@postbote/xmpp": "*",
    "dotenv": "^17.4.2",
    "yargs": "^18.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@gjsify/cli": "0.54.0",
    "@gjsify/napi": "0.54.0",
    "@gjsify/node-globals": "0.54.0",
    "@gjsify/rolldown-native": "0.54.0",
    "@gjsify/runtime": "0.54.0",
    "@gjsify/unit": "0.54.0",
    "@gjsify/ws": "0.54.0",
    "@girs/gjs": "^4.1.0",
    "@girs/glib-2.0": "^4.1.0",
    "@girs/gobject-2.0": "^4.1.0",
    "@girs/gio-2.0": "^4.1.0",
    "@girs/goa-1.0": "^4.1.0",
    "@girs/edataserver-1.2": "^4.1.0",
    "@girs/ebook-1.2": "^4.1.0",
    "@girs/ebookcontacts-1.2": "^4.1.0",
    "@girs/ecal-2.0": "^4.1.0",
    "@girs/icalglib-3.0": "^4.1.0",
    "@signalapp/libsignal-client": "0.103.0",
    "@types/node": "^26.1.2",
    "@types/yargs": "^17.0.35",
    "baileys": "7.0.0-rc14",
    "@xmpp/client": "0.14.0",
    "fake-indexeddb": "6.2.5",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^6.0.3"
  }
}
