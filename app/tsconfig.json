{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // fixed upstream in gjsify (gjsify/gjsify#2763): @gjsify/utils pins @girs 5.4 and nests a second copy next to the app's 4.x
    "paths": {
      "@girs/gjs": ["../node_modules/@girs/gjs/index.d.ts"],
      "@girs/gjs/*": ["../node_modules/@girs/gjs/*"],
      "@girs/glib-2.0": ["../node_modules/@girs/glib-2.0/index.d.ts"],
      "@girs/gobject-2.0": ["../node_modules/@girs/gobject-2.0/index.d.ts"],
      "@girs/gio-2.0": ["../node_modules/@girs/gio-2.0/index.d.ts"],
      "@girs/cairo-1.0": ["../node_modules/@girs/cairo-1.0/index.d.ts"],
      "@girs/pango-1.0": ["../node_modules/@girs/pango-1.0/index.d.ts"],
      "@girs/pangocairo-1.0": ["../node_modules/@girs/pangocairo-1.0/index.d.ts"]
    },
    "types": [
      "node",
      "@girs/gjs",
      "@girs/glib-2.0",
      "@girs/gobject-2.0",
      "@girs/gio-2.0",
      "@girs/giounix-2.0",
      "@girs/goa-1.0",
      "@girs/edataserver-1.2",
      "@girs/ebook-1.2",
      "@girs/ebookcontacts-1.2",
      "@girs/ecal-2.0",
      "@girs/icalglib-3.0",
      "@girs/gdkpixbuf-2.0",
      "@girs/gtk-4.0/ambient",
      "@girs/adw-1/ambient",
      "@girs/gst-1.0/ambient",
      "@girs/xdp-1.0/ambient",
      "@girs/xdpgtk4-1.0/ambient"
    ]
  },
  "include": ["./src/**/*", "./tests/**/*"]
}
