{
  "mcpServers": {
    "curlew": {
      "command": "${CLAUDE_PROJECT_DIR:-.}/node_modules/.bin/gjsify",
      "args": ["run", "${CLAUDE_PROJECT_DIR:-.}/app/dist/curlew.gjs.mjs", "mcp"],
      "cwd": "${CLAUDE_PROJECT_DIR:-.}/app",
      "env": {
        "DOTENV_CONFIG_PATH": "${CLAUDE_PROJECT_DIR:-.}/app/.env"
      }
    }
  }
}
