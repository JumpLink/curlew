{
  "compilerOptions": {
    "module": "esnext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noEmitHelpers": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "preserveSymlinks": true,
    "types": ["@gjsify/rolldown-plugin-gjsify/types", "node"],
    "lib": ["ESNext", "dom"],
    "paths": {
      "~/*": ["./app/*"],
      "@/*": ["./app/*"],
      "@curlew/protocol": ["../packages/protocol/src/index.ts"],
      "@curlew/store/index-db": ["../packages/store/src/index-db-entry.ts"],
      "@curlew/imap/stream": ["../packages/imap/src/stream-entry.gjs.ts"]
    }
  },
  "include": ["app/**/*"],
  "files": ["./references.d.ts"],
  "exclude": ["node_modules", "platforms"]
}
