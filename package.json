{
  "name": "curlew",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Curlew — mail (IMAP), contacts (CardDAV) and calendar (CalDAV) through GNOME Online Accounts, as a CLI and an MCP server. Runs on GJS via gjsify.",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "check": "gjsify foreach -A check",
    "build": "gjsify workspace curlew-cli build",
    "start": "gjsify workspace curlew-cli start",
    "test": "gjsify workspace curlew-cli test",
    "format": "gjsify workspace curlew-cli format",
    "lint": "gjsify workspace curlew-cli lint"
  }
}
