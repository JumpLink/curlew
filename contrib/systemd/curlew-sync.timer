[Unit]
# Runs curlew-sync.service every 15 minutes.
#
#   cp contrib/systemd/curlew-sync.{service,timer} ~/.config/systemd/user/
#   # point WorkingDirectory/ExecStart in the .service at your checkout if it is not ~/curlew
#   systemctl --user daemon-reload
#   systemctl --user enable --now curlew-sync.timer
#   systemctl --user list-timers curlew-sync
Description=curlew — sync mail and chats every 15 minutes

[Timer]
OnBootSec=2min
# Counted from the end of the last run, so a slow sync never overlaps itself.
OnUnitInactiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
