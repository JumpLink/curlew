[Unit]
# postbote — the receiving daemon (ADR 0002).
#
# It receives Signal and WhatsApp into the local index and keeps doing so while you do
# nothing: those networks keep no archive, so what the daemon writes is the only copy
# (see the WhatsApp and Signal sections of the README).
#
# Install as a USER unit — postbote reads $XDG_DATA_HOME and reaches GNOME Online
# Accounts over the user session's D-Bus, so it has to run as you anyway:
#
#   mkdir -p ~/.config/systemd/user
#   cp contrib/systemd/postbote-daemon.service ~/.config/systemd/user/
#   # point the two paths below at your checkout if it is not ~/postbote
#   systemctl --user daemon-reload
#   systemctl --user enable --now postbote-daemon
#   loginctl enable-linger "$USER"   # so it also runs while you are logged out
#   journalctl --user -u postbote-daemon -f
#
# Verify: systemd-analyze --user verify <this file>
Description=postbote — receive Signal and WhatsApp into the local index
Documentation=https://github.com/jumplink/postbote/blob/main/docs/adr/0002-receiving-daemon.md
# No After=/PartOf=graphical-session.target on purpose: logging out must not stop a receiver
# whose whole point is staying connected, and the address book it uses for the participant
# link is optional (a daemon without it still receives; the link comes on the next rebuild).
# `loginctl enable-linger` is what lets a user unit run at all without a session.
# StartLimit* belong to [Unit], not [Service] (systemd ignores them there) — a restart storm,
# say a config that no longer names a backend, must not fill the disk.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/postbote
# A user unit's PATH has neither `gjsify install`'s ~/.local/bin nor the shell's, so PATH is
# set explicitly and the command goes through env: systemd would otherwise report
# "Command gjsify is not executable" and refuse to start.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env gjsify run %h/postbote/app/dist/postbote.gjs.mjs daemon
# A dropped socket is retried by the daemon itself (with backoff). A restart here is for
# what it cannot retry: a device the network logged out, an index that cannot be opened.
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
