{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // `node` comes with the @curlew/smtp dependency: tsc checks nodemailer's declarations through
    // it (Buffer, Error.message). The IMAP transport itself still uses gi:// sockets only.
    "types": [
      "node",
      "@girs/gjs",
      "@girs/glib-2.0",
      "@girs/gobject-2.0",
      "@girs/gio-2.0"
    ]
  },
  "include": ["./src/**/*"]
}
