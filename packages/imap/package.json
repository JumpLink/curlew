{
  "name": "@curlew/imap",
  "version": "0.2.2",
  "license": "LGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "IMAP over a byte-stream port (Gio TLS sockets on GJS, node:tls on Node): a minimal RFC 3501 client, and mail search / single-message fetch. The opener is injected; all response and MIME parsing lives in @curlew/protocol. Sending is the separate ./send entry.",
  "exports": {
    ".": {
      "browser": "./src/index.gjs.ts",
      "node": "./src/index.node.ts",
      "default": "./src/index.node.ts"
    },
    "./stream": "./src/stream-entry.gjs.ts",
    "./send": "./src/send-entry.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@girs/gio-2.0": "^4.1.0",
    "@girs/glib-2.0": "^4.1.0",
    "@curlew/protocol": "*",
    "@curlew/smtp": "*",
    "@gjsify/secret-store": "0.64.59",
    "@gjsify/system-accounts": "0.64.54",
    "@curlew/store": "*"
  }
}
