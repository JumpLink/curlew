{
  "name": "@curlew/imap",
  "version": "0.2.0",
  "license": "LGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "IMAP over Gio TLS sockets: transport, a minimal RFC 3501 client, and mail search / single-message fetch. GJS-only (the Node entry is an unavailable stub); all response and MIME parsing lives in @curlew/protocol.",
  "exports": {
    ".": {
      "browser": "./src/index.gjs.ts",
      "node": "./src/index.node.ts",
      "default": "./src/index.node.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@girs/gio-2.0": "^4.1.0",
    "@girs/glib-2.0": "^4.1.0",
    "@curlew/protocol": "*",
    "@curlew/smtp": "*",
    "@gjsify/system-accounts": "0.64.22",
    "@curlew/store": "*"
  }
}
